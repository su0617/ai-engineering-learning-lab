# 复制为 .env 后填写。不要把 .env 提交到 GitHub。
# 你可以使用 DeepSeek 官方地址，也可以使用自己的 OpenAI 兼容中转站。

# 你之前的中转站配置方式
GUAIHUB_MODEL=deepseek-chat
GUAIHUB_API_KEY=在这里填写你的API_Key
GUAIHUB_BASE_URL=https://你的中转站地址/v1

# 如果使用 DeepSeek 官方接口，可改成：
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=在这里填写你的DeepSeek_API_Key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# 可选：只有运行高级搜索工具时才需要
# TAVILY_API_KEY=tvly-在这里填写你的Tavily_Key
# SERPAPI_API_KEY=在这里填写你的SerpAPI_Key
