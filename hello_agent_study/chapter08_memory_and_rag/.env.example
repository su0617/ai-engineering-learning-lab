# 第八章示例配置模板
# 复制为 .env 后填写；不要把 .env 提交到 GitHub。
# 当前示例使用 HelloAgents 的 OpenAI 兼容接口，聊天模型可填写 DeepSeek。

LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# 只有运行完整 Memory/RAG 示例时才需要配置数据库。
# 本地服务示例：
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_local_password

QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# Embedding 可按 HelloAgents 版本选择云端或本地方案。
# DeepSeek 聊天 API 不等于 Embedding API，二者需要分别配置。
# EMBED_MODEL_TYPE=local
# EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBED_API_KEY=
# EMBED_BASE_URL=

# 第 11 个示例的本地 Web 服务配置。
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
