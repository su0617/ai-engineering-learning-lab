# OpenAI-compatible LLM provider configuration.
# Copy this file to .env locally, then fill in your own values.
GUAIHUB_API_KEY=your_api_key_here
GUAIHUB_BASE_URL=https://your-provider.example/v1
GUAIHUB_MODEL=your_model_name_here

# Optional web-search provider used by the two study demos.
TAVILY_API_KEY=your_tavily_key_here

