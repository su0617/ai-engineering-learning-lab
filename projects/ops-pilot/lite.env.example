# Local-only Lite Mode configuration.
# Copy this file to .env and fill in only DEEPSEEK_API_KEY when ready.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LITE_LLM_PROVIDER=deepseek
LITE_LLM_MODEL=deepseek-chat

# Existing local embedding service/model; no new model download is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
